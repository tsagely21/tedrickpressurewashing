# Copy to .env and fill in. Never commit .env.

# Password for the owner dashboard at /admin/. If unset, a random one is printed to the console on each start.
OWNER_PASSWORD=
# Optional: keeps owner logins valid across restarts (any long random string).
SESSION_SECRET=

# Public address of the site (used in links inside emails), e.g. https://www.example.com
PUBLIC_URL=

# Email notifications via Resend (https://resend.com). All three are required; without them the site runs in
# DEMO MODE for email: messages are written to data/outbox.log instead of being sent.
RESEND_API_KEY=
MAIL_FROM=Tedrick Mobile Pressure Washing <quotes@your-verified-domain.com>
OWNER_EMAIL=

# Optional
PORT=3000
# Where the database and uploaded photos live. Must be on persistent storage in production.
# DATA_DIR=data
